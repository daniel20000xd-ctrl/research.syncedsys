# Research Supabase project — every script connects through the SESSION POOLER
# (the direct db.<ref> host is IPv6-only). Leave the URL passwordless; passwords are
# supplied per role below, so special / non-ASCII characters are fine.
# Find it via the dashboard's "Connect" button → Session pooler.
RESEARCH_DATABASE_URL=postgresql://postgres.your-project-ref@aws-0-your-region.pooler.supabase.com:5432/postgres

# postgres — migrations only (migrate.py)
RESEARCH_DB_PASSWORD=
# pipeline role — ingest.py + enrich.py (created by migration 005; migrate.py sets the password)
PIPELINE_DB_PASSWORD=
# mcp_reader role — mcp_server.py, SELECT on the mcp_* views only
MCP_READER_DB_PASSWORD=

# enrich.py — Claude API adjudication
ANTHROPIC_API_KEY=

# ── Cloudflare R2 (REQUIRED) ─────────────────────────────────────────────────
# Heavy content lives in R2, not Postgres: extracted text (full_text_path), PDF
# originals (raw_pdf_path) and the untouched source record (raw.json).
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=syncedsys-storage

# Embeddings are LOCAL (KBLab/sentence-bert-swedish-cased, 768d) — no embedding API key.
