# Research Supabase project (separate from the main Syncedsys project)
RESEARCH_SUPABASE_URL=https://your-project-ref.supabase.co
RESEARCH_SUPABASE_SERVICE_KEY=eyJ...

# Database password (Supabase → Settings → Database). Passed to psycopg2
# separately (not embedded in the URL), so special / non-ASCII characters are
# fine. Wrap it in double quotes if it contains any: RESEARCH_DB_PASSWORD="a@b#c"
RESEARCH_DB_PASSWORD=

# Direct Postgres connection for DDL (psycopg2). Use the SESSION POOLER string
# for YOUR project's region — the host region (e.g. eu-west-1) and the
# postgres.<project-ref> username must match your project. Leave it passwordless;
# the password is supplied from RESEARCH_DB_PASSWORD above.
# Find it via the dashboard's "Connect" button → Session pooler.
RESEARCH_DATABASE_URL=postgresql://postgres.your-project-ref@aws-0-your-region.pooler.supabase.com:5432/postgres

# Anthropic — only needed for the pipeline's enrich.py / connect.py. Phase 2/3
# now run through Claude + MCP, so plain ingest does NOT need this. Optional:
ANTHROPIC_API_KEY=sk-ant-...
